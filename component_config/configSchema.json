{
  "type": "object",
  "title": "Oracle EBS Writer — Connection Settings",
  "properties": {
    "connection": {
      "type": "object",
      "title": "Database Connection",
      "format": "grid-strict",
      "propertyOrder": 1,
      "required": ["db_host", "db_service_name", "#db_user", "#db_password"],
      "properties": {
        "db_host": {
          "type": "string",
          "title": "Database Host",
          "description": "Hostname or IP address of the Oracle database server",
          "propertyOrder": 1,
          "options": {
            "grid_columns": 8
          }
        },
        "db_port": {
          "type": "integer",
          "title": "Port",
          "default": 1521,
          "propertyOrder": 2,
          "options": {
            "grid_columns": 2
          }
        },
        "test_connection": {
          "type": "button",
          "format": "test-connection",
          "propertyOrder": 3,
          "options": {
            "grid_columns": 2
          }
        },
        "db_service_name": {
          "type": "string",
          "title": "Service Name",
          "description": "Oracle service name (e.g. ebs_EBSDB)",
          "propertyOrder": 4,
          "options": {
            "grid_columns": 12
          }
        },
        "#db_user": {
          "type": "string",
          "title": "DB Username",
          "description": "Database user with write access to EBS interface tables",
          "propertyOrder": 5,
          "options": {
            "grid_columns": 6
          }
        },
        "#db_password": {
          "type": "string",
          "title": "DB Password",
          "format": "password",
          "propertyOrder": 6,
          "options": {
            "grid_columns": 6
          }
        }
      }
    },
    "rest_url": {
      "type": "string",
      "title": "EBS REST API URL",
      "description": "ISG REST API base URL (e.g. http://host:8000/webservices/rest). Required for TCA and AR writes.",
      "propertyOrder": 2
    },
    "#rest_user": {
      "type": "string",
      "title": "REST API Username",
      "description": "EBS REST API user (typically SYSADMIN)",
      "propertyOrder": 3
    },
    "#rest_password": {
      "type": "string",
      "title": "REST API Password",
      "format": "password",
      "propertyOrder": 4
    },
    "default_org_id": {
      "type": "integer",
      "title": "Default Org ID",
      "description": "Default operating unit ID for REST API calls (e.g. 204 = Vision Operations)",
      "default": 204,
      "propertyOrder": 5
    }
  }
}
