{
  "type": "object",
  "title": "Write Row",
  "required": ["destination"],
  "properties": {
    "destination": {
      "type": "object",
      "title": "Destination",
      "format": "collapse",
      "propertyOrder": 1,
      "properties": {
        "write_mode": {
          "type": "string",
          "title": "Write Mode",
          "enum": ["preset", "custom"],
          "default": "preset",
          "propertyOrder": 1
        },
        "module": {
          "type": "string",
          "title": "EBS Module",
          "enum": ["ap", "ar", "gl", "po", "inv", "tca"],
          "propertyOrder": 2,
          "default":"ap",
          "options": {
            "enum_titles": [
              "Accounts Payable (AP)",
              "Accounts Receivable (AR)",
              "General Ledger (GL)",
              "Purchasing (PO)",
              "Inventory (INV)",
              "Trading Community (TCA)"
            ],
            "dependencies": {
              "destination.write_mode": "preset"
            }
          }
        },
        "entity": {
          "type": "string",
          "title": "Target Entity (Interface Table)",
          "format": "select",
          "enum": [],
          "propertyOrder": 3,
          "options": {
            "async": {
              "label": "Load Entities",
              "action": "listEntities",
              "creatable": true
            },
            "dependencies": {
              "destination.write_mode": "preset"
            }
          }
        },
        "org_id": {
          "type": "integer",
          "title": "Operating Unit (Org ID)",
          "format": "select",
          "enum": [],
          "propertyOrder": 4,
          "options": {
            "async": {
              "label": "Load Operating Units",
              "action": "listOperatingUnits",
              "creatable": true
            },
            "dependencies": {
              "destination.write_mode": "preset"
            }
          }
        },
        "ledger_id": {
          "type": "string",
          "title": "Ledger",
          "format": "select",
          "enum": [],
          "propertyOrder": 5,
          "options": {
            "async": {
              "label": "Load Ledgers",
              "action": "listLedgers",
              "creatable": true
            },
            "dependencies": {
              "destination.write_mode": "preset",
              "destination.module": "gl"
            }
          }
        },
        "target_table": {
          "type": "string",
          "title": "Target Table",
          "description": "Full Oracle table name (e.g. APPS.MY_CUSTOM_TABLE)",
          "propertyOrder": 6,
          "options": {
            "dependencies": {
              "destination.write_mode": "custom"
            }
          }
        },
        "write_operation": {
          "type": "string",
          "title": "Write Operation",
          "enum": ["insert", "upsert"],
          "default": "insert",
          "description": "INSERT adds all rows. UPSERT updates existing rows by primary key and inserts new ones.",
          "propertyOrder": 7
        },
        "primary_key": {
          "type": "array",
          "title": "Primary Key Columns",
          "description": "Required for upsert. Used to match existing rows in the target table.",
          "format": "select",
          "items": {
            "type": "string",
            "enum": []
          },
          "uniqueItems": true,
          "propertyOrder": 8,
          "options": {
            "tags": true,
            "async": {
              "label": "Load Target Columns",
              "action": "listTargetColumns"
            },
            "dependencies": {
              "destination.write_operation": "upsert"
            }
          }
        },
        "reload_columns": {
          "type": "button",
          "format": "sync-action",
          "title": "Load Columns",
          "description": "Append the canonical target columns of the selected entity (preset) or table (custom) to the column mapping below. Source values are fuzzy-matched against the assigned input table's columns (exact, case-insensitive, then ignoring underscores/dashes/spaces). Append-only — existing rows are never modified or removed.",
          "propertyOrder": 10,
          "options": {
            "async": {
              "label": "Load Columns",
              "action": "reloadColumns"
            }
          }
        },
        "column_mapping": {
          "type": "array",
          "title": "Column Mapping",
          "description": "Map input CSV columns to target Oracle columns. Only listed columns are written; unmapped input columns are dropped. Click 'Load Target Columns' above to pre-populate destination columns.",
          "format": "table",
          "uniqueItems": true,
          "propertyOrder": 9,
          "items": {
            "type": "object",
            "required": ["source", "destination"],
            "properties": {
              "source": {
                "type": "string",
                "title": "Source Column",
                "format": "select",
                "enum": [],
                "options": {
                  "tags": true,
                  "watch": {"columns": "_metadata_.table.columns"},
                  "enumSource": "columns"
                }
              },
              "destination": {
                "type": "string",
                "title": "Target Column"
              }
            }
          }
        },
        "batch_size": {
          "type": "integer",
          "title": "Batch Size",
          "description": "Number of rows per INSERT/MERGE batch (default 1000).",
          "default": 1000,
          "propertyOrder": 11
        },
        "submit_program": {
          "type": "boolean",
          "title": "Submit Concurrent Program",
          "description": "After loading rows into the staging interface table, trigger the EBS concurrent program (e.g. Payables Open Interface Import) that imports them into the live tables. Only applies to interface-based presets.",
          "default": true,
          "format": "checkbox",
          "propertyOrder": 12,
          "options": {
            "dependencies": {
              "destination.write_mode": "preset"
            }
          }
        },
        "wait_for_completion": {
          "type": "boolean",
          "title": "Wait for Completion",
          "description": "Block until the submitted concurrent program finishes. If disabled, the component returns immediately after submission.",
          "default": true,
          "format": "checkbox",
          "propertyOrder": 13,
          "options": {
            "dependencies": {
              "destination.write_mode": "preset",
              "destination.submit_program": true
            }
          }
        },
        "poll_interval": {
          "type": "integer",
          "title": "Poll Interval (seconds)",
          "description": "How often to check the concurrent program status while waiting.",
          "default": 10,
          "propertyOrder": 14,
          "options": {
            "dependencies": {
              "destination.write_mode": "preset",
              "destination.submit_program": true
            }
          }
        },
        "poll_timeout": {
          "type": "integer",
          "title": "Poll Timeout (seconds)",
          "description": "Max seconds to wait for the concurrent program to finish before giving up.",
          "default": 600,
          "propertyOrder": 15,
          "options": {
            "dependencies": {
              "destination.write_mode": "preset",
              "destination.submit_program": true
            }
          }
        }
      }
    },
    "_metadata_": {
      "type": "object",
      "options": {
        "hidden": true
      },
      "properties": {
        "table": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    }
  }
}